function WeaponConfig.GetUnlockedWeaponsForLevel(level)
	local unlocked = {}
	for _, entry in ipairs(WeaponConfig.LevelUnlocks) do
		if level >= entry.level then
			table.insert(unlocked, entry.weapon)
		end
	end
	return unlocked
end

return WeaponConfig
