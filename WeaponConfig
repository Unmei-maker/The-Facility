--[[
	WeaponConfig.lua
	Weapon level-unlock progression and ammo types per weapon category
	(Sections 21-23). Premium ammo requires Robux to UNLOCK the type;
	actual rounds are always bought with Facility Credits -- this
	distinction matters for EconomySystem, so it's kept explicit here.
]]

local WeaponConfig = {}

-- Free weapon progression by player level.
WeaponConfig.LevelUnlocks = {
	{ level = 1, weapon = "Pistol" },
	{ level = 10, weapon = "Shotgun" },
	{ level = 20, weapon = "SMG" },
	{ level = 30, weapon = "AssaultRifle" },
}

-- Premium sidegrade weapons -- different handling/sound/reload, not
-- strictly better than their free counterpart.
WeaponConfig.PremiumSidegrades = {
	AssaultRifle = "HK416", -- premium sidegrade of the free M4A1-equivalent
}

-- Ammo types per weapon category. `isPremium = true` means it must be
