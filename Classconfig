-- Flat lookup: subclassId -> { className, ...abilityData }
-- Built once at require-time so ClassSystem doesn't need nested iteration.
ClassConfig.SubclassLookup = {}
for className, subclasses in pairs(ClassConfig.Classes) do
	for subclassId, data in pairs(subclasses) do
		local entry = table.clone(data)
		entry.className = className
		entry.subclassId = subclassId
		ClassConfig.SubclassLookup[subclassId] = entry
	end
end

return ClassConfig
